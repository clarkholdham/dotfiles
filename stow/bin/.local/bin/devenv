#!/bin/bash

set -e

mode=${1:-up}
shift  # Remove mode from arguments

workspace_folder="."
container_user="user"

# For most modes, extract workspace_folder and container_user from remaining args.
# For exec mode, -w overrides the directory to cd into inside the container.
if [ "$mode" != "exec" ]; then
    workspace_folder=${1:-.}
    shift 2>/dev/null || true
    container_user=${1:-user}
else
    # For exec, -w sets the host path to cd into inside the container (translated automatically)
    if [ "$1" = "-w" ]; then
        shift
        workspace_folder=${1:-.}
        shift
    fi
fi

# Find the real devcontainer CLI (installed via npm) to avoid recursion
# The wrapper script itself is at ~/.local/bin/devcontainer, so we need to find the actual CLI
REAL_DEVCONTAINER=$(find ~/.nvm/versions/node/*/bin/devcontainer 2>/dev/null | head -1)
if [ -z "$REAL_DEVCONTAINER" ]; then
    echo "Error: devcontainer CLI not found. Install with: npm install -g @devcontainers/cli"
    exit 1
fi

# Create an alias to avoid calling ourselves recursively
alias devcontainer-cli="$REAL_DEVCONTAINER"

dotfiles_repo="https://github.com/clarkholdham/dotfiles.git"

additional_features="{
    \"ghcr.io/devcontainers-extra/features/apt-packages:1\": {
      \"packages\": \"ca-certificates,curl,git,git-lfs,htop,pax-utils,ssh,stow,sudo,tmux,vim,xsel,zsh\",
      \"ppas\": \"ppa:git-core/ppa\"
    },
    \"ghcr.io/meaningful-ooo/devcontainer-features/homebrew:2\": {
      \"shallowClone\": true
    },
    \"ghcr.io/jmdaly/features/homebrew-packages:1\": {
      \"packages\": \"jira-cli,glab,avivsinai/tap/jk\"
    }
}"

# Find the workspace folder that contains .devcontainer/.
# Strategy: check the primary git worktree first. Since .devcontainer is tracked in git it
# exists in every worktree, so walking up the directory tree would always find the worktree's
# own copy — we must prefer the primary worktree to ensure all worktrees share one container.
# Fall back to walking up for non-git repos or repos without a main-worktree devcontainer.
find_devcontainer_root() {
    local path
    path=$(realpath "${1:-.}")

    # Prefer the primary worktree (first line of `git worktree list`)
    local main_worktree
    main_worktree=$(git -C "$path" worktree list 2>/dev/null | head -1 | awk '{print $1}')
    if [[ -n "$main_worktree" && -d "$main_worktree/.devcontainer" ]]; then
        echo "$main_worktree"
        return 0
    fi

    # Fall back: walk up the directory tree (handles non-git repos)
    local check="$path"
    while [[ "$check" != "/" ]]; do
        if [[ -d "$check/.devcontainer" ]]; then
            echo "$check"
            return 0
        fi
        check=$(dirname "$check")
    done

    # No .devcontainer found — return original path and let devcontainer CLI surface the error
    echo "$path"
}

# Translate a host path to its equivalent inside the container.
# devcontainer.json always mounts source=${env:HOME},target=/home/host so
# any path under $HOME is reliably accessible at /home/host/... regardless
# of whether the container was started by devenv or VS Code.
host_to_container_path() {
    local host_path="$1"
    echo "${host_path/#$HOME//home/host}"
}

# Resolve the invocation path, find the devcontainer root, and derive the in-container cwd
invocation_path=$(realpath "${workspace_folder:-.}")
devcontainer_root=$(find_devcontainer_root "$invocation_path")
container_cwd=$(host_to_container_path "$invocation_path")

if [[ "$devcontainer_root" != "$invocation_path" ]]; then
    echo "ℹ️  Worktree detected — using devcontainer from: $devcontainer_root"
    echo "   Working directory inside container: $container_cwd"
fi

build_devcontainer() {
    local workspace_folder=$1

    echo "Building devcontainer with workspace folder: ${workspace_folder}"

    devcontainer build --no-cache --workspace-folder ${workspace_folder} \
        --additional-features "${additional_features}"
}

start_devcontainer() {
    local workspace_folder=$1
    local container_user=$2

    echo "Starting devcontainer with workspace folder: ${workspace_folder}"

    devcontainer up --workspace-folder ${workspace_folder} \
        --dotfiles-repository ${dotfiles_repo} \
        --additional-features "${additional_features}" \
        --mount type=bind,source=${SSH_AUTH_SOCK},target=/run/host-services/ssh-auth.sock

    # Run a few commands to set up the environment for me.
    devcontainer exec --workspace-folder ${workspace_folder} \
        /bin/bash -c "sudo chsh ${container_user} -s /usr/bin/zsh"
}

exec_devcontainer() {
    local workspace_folder=$1
    local container_cwd=$2
    shift 2
    local shell="zsh"

    # If no command provided, launch interactive shell in the current worktree directory
    if [ $# -eq 0 ]; then
        devcontainer exec --workspace-folder "${workspace_folder}" \
            --remote-env TERM=$TERM \
            --remote-env SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock \
            --remote-env SHELL=$shell \
            /bin/bash -c "cd '${container_cwd}' && exec ${shell}"
    else
        # Run provided command inside the current worktree directory
        devcontainer exec --workspace-folder "${workspace_folder}" \
            --remote-env TERM=$TERM \
            --remote-env SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock \
            --remote-env SHELL=$shell \
            /bin/bash -c "cd '${container_cwd}' && $(printf '%q ' "$@")"
    fi
}

stop_devcontainer() {
    local workspace_folder=$1
    
    echo "Stopping devcontainer for workspace folder: ${workspace_folder}"
    
    docker compose -f "${workspace_folder}/.devcontainer/compose.yaml" stop
}

remove_devcontainer() {
    local workspace_folder=$1
    
    echo "Removing devcontainer for workspace folder: ${workspace_folder}"
    
    docker compose -f "${workspace_folder}/.devcontainer/compose.yaml" down
}

if [ "$mode" == "up" ]; then
    start_devcontainer "$devcontainer_root" "$container_user"
elif [ "$mode" == "build" ]; then
    build_devcontainer "$devcontainer_root"
elif [ "$mode" == "exec" ]; then
    exec_devcontainer "$devcontainer_root" "$container_cwd" "$@"
elif [ "$mode" == "stop" ]; then
    stop_devcontainer "$devcontainer_root"
elif [ "$mode" == "down" ]; then
    remove_devcontainer "$devcontainer_root"
else
    echo "Invalid command: $mode"
    exit 1
fi
